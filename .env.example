# ─── KawaiiLife — environment variables ─────────────────────────────────────
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# IMPORTANT: `.env` is gitignored and NEVER committed. This file has no secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server (used by the Node/Express backend, incl. Docker) ────────────────
PORT=3001
NODE_ENV=production
# Strong random secret for JWT signing — generate with e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ─── Firebase (server-side Admin SDK) ───────────────────────────────────────
# Your Firebase Realtime Database URL (this value is public-safe)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/

# Paste the FULL contents of your Firebase service-account.json as a raw
# single-line JSON string. NEVER commit this value.
# Locally you can also place the file at server/service-account.json instead.
FIREBASE_SERVICE_ACCOUNT=

# ─── File uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ─── Web (build-time Vite vars — baked into the frontend bundle) ────────────
# API + WebSocket are same-origin through Nginx in Docker (defaults below).
# Override only if you run against an external API host.
VITE_API_URL=/api
# Set to "/" to enable Socket.IO (chat/watch party realtime) in Docker;
# leave empty to disable (REST + polling only, e.g. Vercel serverless).
VITE_WS_URL=/

# Public/client-safe Firebase config for the Virtual Study Room RTDB
# signaling. Optional — study room realtime degrades gracefully if unset.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=

# Optional: enables YouTube search in the Music tab (YouTube Data API v3 key).
# Without it, curated stations + paste-a-link still work — search just hides.
# Get a free key: Google Cloud → enable "YouTube Data API v3" → API key.
VITE_YOUTUBE_API_KEY=

# ─── Docker (compose port overrides) ────────────────────────────────────────
# Change only if the defaults conflict on your machine
WEB_PORT=80
BACKEND_PORT=3001