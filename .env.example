# Server
PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d

# For production, swap SQLite for Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/productivity

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
