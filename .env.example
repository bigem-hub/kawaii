# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Your Firebase Realtime Database URL
FIREBASE_DATABASE_URL=https://kawaiilife-55132-default-rtdb.firebaseio.com/

# Paste the FULL contents of your service-account.json here as a single-line JSON string.
# In production (Railway), set this as an environment variable.
# Locally, you can place the file at server/service-account.json instead.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# ─── File uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
